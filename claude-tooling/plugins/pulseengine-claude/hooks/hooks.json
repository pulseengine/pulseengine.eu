{
  "description": "Always-on PulseEngine context: at session start inject the methodology memory, situational awareness (git state, repo category, resumed working context), and — in a rivet project — the traceability state plus the rivet command surface to use instead of grepping artifact YAML; persist a working-context checkpoint on session end and before compaction so work resumes instead of starting cold.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/inject-pulseengine-memory.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/inject-situational-awareness.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/inject-rivet-context.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/save-working-context.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/save-working-context.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
